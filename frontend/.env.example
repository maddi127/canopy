# Frontend build-time variables (Vite). These are embedded into the
# client bundle at build time and are publicly visible — use keys that
# are safe to expose / referrer-restricted.
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GOOGLE_MAPS_KEY=your-google-maps-browser-key
VITE_MAPBOX_TOKEN=your-mapbox-public-token
